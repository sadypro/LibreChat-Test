#==================================================#
#   LibreChat Code API -> AgentCore Code Interpreter #
#==================================================#
# Only the first block is required. Every other value shows its default.

# --- Required ---------------------------------------------------------------
AWS_REGION=us-east-1
AGENTCORE_S3_BUCKET=my-librechat-code-files
# Public half of LibreChat's CODEAPI_JWT_PRIVATE_KEY (PEM, escaped \n allowed, or a public JWK).
AGENTCORE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Shared by every replica so programmatic tool calls can resume anywhere (>= 32 chars).
AGENTCORE_PROGRAMMATIC_TOKEN_SECRET=

# --- Server -------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8790
# AGENTCORE_JSON_BODY_LIMIT_BYTES=10485760

# --- JWT verification (must match LibreChat's CODEAPI_JWT_* settings) ---------
# AGENTCORE_JWT_PUBLIC_KEY_BASE64=
# AGENTCORE_JWT_JWKS={"keys":[{"kty":"OKP","crv":"Ed25519","x":"...","kid":"lc-codeapi-2026-05"}]}
# AGENTCORE_JWT_KID=
# AGENTCORE_JWT_ISSUER=librechat
# AGENTCORE_JWT_AUDIENCE=codeapi
# AGENTCORE_JWT_ALGORITHMS=EdDSA,RS256
# AGENTCORE_JWT_CLOCK_SKEW_SECONDS=30
# AGENTCORE_JWT_MAX_TOKEN_AGE_SECONDS=600
# Tenant for tokens without tenant_id; leave unset to reject them.
# AGENTCORE_JWT_DEFAULT_TENANT_ID=

# --- AgentCore Code Interpreter -----------------------------------------------
# AGENTCORE_REGION=            (defaults to AWS_REGION)
# AGENTCORE_ENDPOINT=
# AGENTCORE_CODE_INTERPRETER_ID=aws.codeinterpreter.v1
# AGENTCORE_SESSION_TIMEOUT_SECONDS=900
# AGENTCORE_SESSION_IDLE_SECONDS=300
# AGENTCORE_REUSE_SESSIONS=true
# AGENTCORE_MAX_SESSIONS_PER_USER=2
# AGENTCORE_MAX_SESSIONS=50
# AGENTCORE_ACQUIRE_TIMEOUT_MS=10000

# --- File storage (S3) ----------------------------------------------------------
# AGENTCORE_S3_PREFIX=librechat-code/
# AGENTCORE_S3_REGION=         (defaults to the AgentCore region)
# AGENTCORE_S3_ENDPOINT=
# AGENTCORE_S3_FORCE_PATH_STYLE=false
# AGENTCORE_S3_KMS_KEY_ID=     (SSE-KMS; SSE-S3 when unset)
# AGENTCORE_FILE_TTL_HOURS=24

# --- Execution ------------------------------------------------------------------
# AGENTCORE_DATA_DIR=/mnt/data
# AGENTCORE_EXEC_DEFAULT_TIMEOUT_MS=60000
# AGENTCORE_EXEC_MAX_TIMEOUT_MS=300000
# AGENTCORE_MAX_STDOUT_BYTES=262144
# AGENTCORE_MAX_INPUT_FILES=100
# AGENTCORE_MAX_INPUT_BYTES=157286400
# AGENTCORE_MAX_OUTPUT_FILES=50
# AGENTCORE_MAX_OUTPUT_FILE_BYTES=52428800
# AGENTCORE_MAX_OUTPUT_BYTES=209715200
# AGENTCORE_MAX_OUTPUT_DEPTH=8
# AGENTCORE_WRITE_BATCH_BYTES=8388608
# Replaces the language table; {file} is the script, {args} the quoted args.
# AGENTCORE_LANGUAGES={"py":{"extension":"py","command":"python3 {file} {args}"},"bash":{"extension":"sh","command":"bash {file} {args}"}}

# --- Programmatic tool calling ----------------------------------------------------
# AGENTCORE_PROGRAMMATIC_MAX_DURATION_SECONDS=900
# AGENTCORE_PROGRAMMATIC_POLL_INTERVAL_MS=250
# AGENTCORE_PROGRAMMATIC_BATCH_WINDOW_MS=100

# --- Uploads ----------------------------------------------------------------------
# AGENTCORE_UPLOAD_MAX_FILE_BYTES=157286400
# AGENTCORE_UPLOAD_MAX_BATCH_FILES=100
