{
  "name": "@librechat/agentcore",
  "version": "0.1.0",
  "private": true,
  "description": "LibreChat Code API middleware backed by Amazon Bedrock AgentCore Code Interpreter",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "librechat-agentcore": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch",
    "test:ci": "jest --ci"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "3.980.0",
    "@aws-sdk/client-s3": "^3.980.0",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.12.4",
    "@types/supertest": "^7.2.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "rimraf": "^5.0.10",
    "supertest": "^7.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
